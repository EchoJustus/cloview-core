(ns cloview.flutter.modal
  "Declarative :ui/modal on Flutter, built on OverlayPortal (Flutter 3.10+).

  The dialog content is an ordinary part of the widget tree — it re-renders with the db
  like everything else — but is painted in the nearest Overlay (MaterialApp's Navigator
  provides one). There is no Navigator route and no imperative showDialog future, so
  `:open?` in the db is the single source of truth: show/hide follow its edges (applied
  post-frame, never during build), and tapping the barrier dispatches :on-dismiss."
  (:require [cljd.flutter :as f]
            [cloview.core.tree :as t]
            [cloview.flutter.material :as mat]))

(defn- sync-visibility! [ctrl open?]
  (mat/post-frame!
   (fn []
     (if open?
       (when-not (mat/portal-showing? ctrl) (mat/portal-show! ctrl))
       (when (mat/portal-showing? ctrl) (mat/portal-hide! ctrl))))))

(defn modal-widget
  "`content` is the already-rendered child widget."
  [{:keys [open? title on-dismiss]} content dispatch!]
  (let [open? (boolean open?)]
    (f/widget
     :managed [ctrl (mat/overlay-portal-controller) :dispose nil :refresh-on nil]
     :let [_ (when-not (= open? (mat/portal-showing? ctrl))
               (sync-visibility! ctrl open?))]
     (mat/overlay-portal
      ctrl
      (fn []
        (mat/dialog-surface title content
                            (fn [] (when on-dismiss (t/emit! dispatch! on-dismiss :none nil)))))
      (mat/empty-box)))))
